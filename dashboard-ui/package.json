{
  "name": "food-khata-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/licenses.mjs",
    "test": "node src/model.test.js && node src/loader.test.js && vitest run src/lib/api.test.ts src/lib/filters.test.ts src/lib/ledger.test.ts src/app/theme.test.ts src/lib/chart-theme.test.ts src/components/dashboard/ChartCard.test.tsx src/components/dashboard/KpiCard.test.tsx",
    "test:browser": "node scripts/browser-test.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript src/types/openapi.json -o src/types/api.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/entry.tsx src/app src/lib/api.ts src/lib/chart-theme.ts src/lib/response-schema.ts src/lib/filters.ts src/lib/ledger.ts src/lib/tokens.ts src/hooks/api.ts && node scripts/check-colors.mjs && node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
