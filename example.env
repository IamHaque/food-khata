# Food Khata Environment Configuration Template
# Copy this file to .env to customize local or deployment options.
# (.env is gitignored and should never be committed to a public repository).

# Server Configuration
HOST=127.0.0.1
PORT=8765
DATA_DIR=.food-khata/
DB_PATH=.food-khata/food_analytics.db

# Optional Zomato Mobile Emulation Overrides
# Defaults use standard public Android client headers.
# ZOMATO_API_KEY=
# ZOMATO_CLIENT_ID=
# ZOMATO_USER_AGENT=
# ZOMATO_ANDROID_ID=
# ZOMATO_ACCESS_UUID=
# ZOMATO_APP_SESSION_ID=
# ZOMATO_APPSFLYER_UID=
# ZOMATO_FIREBASE_INSTANCE_ID=
# ZOMATO_JUMBO_SESSION_ID=
# ZOMATO_REQUEST_ID=
# ZOMATO_UUID=
